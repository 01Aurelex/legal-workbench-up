# ============================================================
#  法岩律师本地工作台 · Git 忽略规则
#  原则：源码与必要素材入库；构建产物、运行时数据、密钥、
#        体积巨大的模型/依赖一律不入库。
# ============================================================

# ---------------- Python ----------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg-info/
.eggs/
build/lib*/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------------- Node / Tauri 前端 ----------------
node_modules/
.pnpm-store/
src-tauri/target/
# tauri-build 每次构建自动生成，无需入库（注意：.gitignore 不支持行尾注释，
# 这里必须有独立一行，否则整行会被当成模式而失效）
src-tauri/gen/schemas/
src-tauri/.taurignore

# ---------------- Rust（任何位置的构建缓存） ----------------
target/
*.rlib
*.rmeta
*.d
*.pdb
*.exp
*.lib
*.obj

# ---------------- PyInstaller / Cython 构建产物 ----------------
build/src/
build/out/
build/out-mac/
build/tmp/
build/_stripped_src/
build/native_modules.txt
build/_build_all.log
build/_build_all.log.*
build/_pyi_*.log
build/_pyi_*.log.crash
build/_tauri_build*
build/*_old_*
build/issuer_dist/
build/issuer_pkg/
build/issuer_work/
build/legal-workbench/
build/unified/
dist/
*.spec.bak

# ---------------- 本地遗留打包链路（已被 Tauri + NSIS 取代） ----------------
