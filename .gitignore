build/build_intro_pdf.py
build/cleanup.py
build/obf/
build/src_bak/
build/build_log.txt
build/_smoke_ws.txt
build/_gh_port*
# 激活签发后台的打包 zip（内含 Ed25519 私钥，严禁入库）
build/*.zip
build/issuer_*.zip
# entitlements.plist 是 macOS 打包必需的输入文件，必须入库（见下方 -e 例外）
# 图标目录：保留设计源（icon.svg / wrap.html / sidebar.html / icon_512.png / sidebar.png）
build/icon/_*
build/icon/backup_old_icons/
build/icon/setup_raw_*.png
build/icon/setup_icons_strip.png
build/icon/setup_icon*.ico
build/icon/extracted_*.png
build/icon/check.png
# Rust 自解压器：保留源码，只排除构建缓存与预编译二进制
tools/installer-sfx/target/
tools/installer-sfx/7za.exe
tools/installer-sfx/7za.dll

# ---------------- 运行时数据与密钥（绝不入库） ----------------
data/workbench.sqlite3
data/workbench.sqlite3-*
data/audit.log
data/.license
data/.access_token
data/.secret.key
data/config.json
data/backend.log
data/startup_error.log
data/export/
data/invoices/
data/vault/

# ---------------- 模型与大体积素材（用脚本下载） ----------------
resources/*
!resources/README.md

# ---------------- 授权签发后台（含 Ed25519 私钥，严禁入库） ----------------
license-admin/
# 备份/归档的签发物料同样严禁入库
*issuer*/
*.pem
*.p12
*.pfx
*.jks
id_rsa*
id_ed25519*

# ---------------- 个人收款/公众号二维码（涉及个人信息，不入库） ----------------
